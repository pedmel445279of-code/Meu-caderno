programa{
	funcao inicio(){

		real temperatura
	
		escreva("Informe a temperatura")
		leia(temperatura)

		se(temperatura <=20){
			escreva("Está começando a congelar")
		}senao{
			escreva("Temperatura ambiente(agradavel)")
		}
	}
}

