programa
{
	
	funcao inicio()
	{
		//casos
		//para iniciar as escolhas do caso voce usa o 
		//"
		//escolha(variavel que voce deseja fazer a escolha){
		//	caso 1:
		//		Codigo
		//	para 
		//	caso 2:
		//		codigo 
		//	pare 
		//	caso n:
		//		codigo 
		//	pare 
		//	caso contrario:
		//		ultimo codigo
		//}"
		
		inteiro meses
	
		escreva("Escreva o número do mes que você deseja ")
		leia(meses)

		escolha(meses){

			caso 1:
				escreva("Janeiro")
			pare
			caso 2:
				escreva("Fevereiro")
			pare
			caso 3:
				escreva("Março") 
			pare
			caso 4:
				escreva("Abril")
			pare
			caso 5:
				escreva("Maio")
			pare
			caso 6:
				escreva("Junho")
			pare
			caso 7:
				escreva("Julho")
			pare 
			caso 8:
			 	escreva("Agosto")
			pare	
			caso 9: 
				escreva("Setembro")	
			pare
			caso 10:
				escreva("Outrubro")
			pare
			caso 11:
				escreva("Novembro")
			pare
			caso 12:
				escreva("Dezembro")
			pare
			caso contrario:
				escreva("Escreva apenas números de 1 a 12")
			pare
			
		}
		
	}
}
