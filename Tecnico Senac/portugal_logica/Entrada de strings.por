programa
{
	
	funcao inicio()
	{

	//1. Soma de dois números
     //Crie um algoritmo que:
	//Peça dois números ao usuário.
     //Some os dois.
     //Mostre o resultado.

     inteiro x,y, resultado

     escreva("Você digito\n") //Saída de valor para o conseole
     x = 5 //entrada de valor(o usuario que digita)


	escreva("Você digito\n")
     y = 6

	resultado = x + y

	escreva("A só de ", x, " + ", y, " resultou em ", resultado, "\n")
	
	}
}
