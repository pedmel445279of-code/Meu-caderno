programa
{
	
	funcao inicio()
	{
	inteiro tabuada = 7
	inteiro parcela
	inteiro resultado = 0
	
		para(parcela = 1; parcela <=10; parcela++){

		resultado=tabuada*parcela

			escreva(resultado + "\n")
			
		}
	}
}
