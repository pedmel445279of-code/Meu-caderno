programa
{
	
	funcao inicio()
	{
		//teste com algumas strings
		//cadeia de caracter (por isso é uma string)
		cadeia nome
		inteiro idade

		escreva("Qual é o seu nome?")
		leia(nome)

		escreva("Qual é a sua idade?")
		leia(idade)


		escreva("Cadastro:\nNome: ", nome, "\nIdade: ", idade)
		
	}
}
