programa
{
	
	funcao inicio()
	{
		//leia() entrada de dado
		//escreva() saida de dado
		//inteiro Declaraçãode de vaiaveis numericas
		//real Deckaração de variavei com decimais

		//inteiro number1,number2, resultado
		real number1,number2, resultado

		escreva("Digite um número:")
	
		leia(number1)

		escreva("Digite um segundo número:")
		leia(number2)

		resultado = number1 + number2

		escreva("A soma de ", number1, " + ", number2, " é: ", resultado)
		
	}
}
